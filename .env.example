# =====================================================================
# LearnHub Course Platform — Environment Variables
# Copy this file to .env and fill in your values.
# =====================================================================

# ---------------------
# API Server (artifacts/api-server)
# ---------------------

# Port the Express API server listens on (default: 8080)
PORT=8080

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/learnhub

# JWT secret used to sign/verify tokens. Change this to a long random string in production!
SESSION_SECRET=change-me-to-a-long-random-secret-value

# ---------------------
# Frontend (artifacts/course-platform)
# ---------------------

# Port the Vite dev server listens on (default: 8081)
# PORT=8081

# Base path for the app (default: "/")
# BASE_PATH=/

# URL of the API server — used in the frontend to make API calls
VITE_API_URL=http://localhost:8080
